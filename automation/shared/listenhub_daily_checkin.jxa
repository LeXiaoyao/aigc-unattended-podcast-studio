#!/usr/bin/osascript -l JavaScript

ObjC.import("stdlib");

function sleep(seconds) {
  delay(seconds);
}

function nowIso() {
  return new Date().toISOString();
}

function shellExec(cmd) {
  const app = Application.currentApplication();
  app.includeStandardAdditions = true;
  return app.doShellScript(cmd);
}

function readPoints() {
  let rootDir = ".";
  try {
    const envRoot = ObjC.unwrap($.NSProcessInfo.processInfo.environment.objectForKey("PODCAST_ROOT_DIR"));
    if (envRoot) rootDir = String(envRoot);
  } catch (e) {}
  const raw = shellExec('/usr/bin/python3 "' + rootDir + '/automation/shared/listenhub_balance.py"');
  const points = Number(raw);
  if (!raw.trim() || !Number.isFinite(points)) throw new Error("积分接口未返回有效余额");
  return points;
}

function chrome() {
  const candidates = ["com.google.Chrome", "Google Chrome", "Chrome"];

  function tryFind() {
    let lastError = null;
    for (const name of candidates) {
      try {
        const app = Application(name);
        app.includeStandardAdditions = true;
        app.running();
        return app;
      } catch (error) {
        lastError = error;
      }
    }
    return lastError;
  }

  const first = tryFind();
  if (first && typeof first.running === "function") return first;

  // Chrome not found — launch it and retry once
  shellExec('open -a "Google Chrome"');
  delay(4);

  const second = tryFind();
  if (second && typeof second.running === "function") return second;

  throw new Error("Google Chrome 应用不可用，启动后仍无法访问: " + String(second && second.message || second));
}

function ensureChromeWindow(app) {
  if (!app.running()) {
    app.activate();
    sleep(2);
  }

  const windows = app.windows();
  if (windows.length > 0) {
    return windows[0];
  }

  shellExec('open -a "Google Chrome"');
  sleep(2);

  if (app.windows().length === 0) {
    throw new Error("Google Chrome 没有可用窗口，请先打开 Chrome");
  }

  return app.windows()[0];
}

function activeTab(win) {
  return win.activeTab();
}

function tabUrl(tab) {
  try {
    return String(tab.url() || "");
  } catch (error) {
    return "";
  }
}

function runJs(tab, source) {
  try {
    const result = tab.execute({ javascript: source });
    if (result === undefined || result === null) return "";
    return String(result);
  } catch (e) {
    return "";
  }
}

function openUrl(tab, url) {
  tab.url = url;
}

function selectListenHubTab(app) {
  const win = ensureChromeWindow(app);
  const windows = app.windows();
  let fallback = { win: win, tab: activeTab(win), index: null };
  let listenhubFallback = null;

  for (let w = 0; w < windows.length; w += 1) {
    const currentWin = windows[w];
    const tabs = currentWin.tabs();
    for (let i = 0; i < tabs.length; i += 1) {
      const tab = tabs[i];
      const url = tabUrl(tab);
      if (!url.includes("listenhub.ai")) {
        continue;
      }

      const item = { win: currentWin, tab: tab, index: i + 1 };
      if (!listenhubFallback) {
        listenhubFallback = item;
      }

      const stateRaw = runJs(
        tab,
        `
          (() => {
            const text = document.body ? document.body.innerText || '' : '';
            const compact = text.replace(/\\s+/g, ' ');
            const pointsMatch = compact.match(/积分\\s*(\\d{1,6})/);
            return JSON.stringify({
              loggedIn: !compact.includes('登录 Hi') && Boolean(pointsMatch && Number(pointsMatch[1]) >= 0),
              points: pointsMatch ? Number(pointsMatch[1]) : null
            });
          })()
        `
      );

      try {
        const state = JSON.parse(stateRaw);
        if (state.loggedIn) {
          currentWin.activeTabIndex = i + 1;
          return item;
        }
      } catch (error) {}
    }
  }

  if (listenhubFallback) {
    listenhubFallback.win.activeTabIndex = listenhubFallback.index;
    return listenhubFallback;
  }

  return fallback;
}

function waitForPage(tab, timeoutSeconds) {
  const started = Date.now();
  while (Date.now() - started < timeoutSeconds * 1000) {
    const raw = runJs(
      tab,
      `
        (() => {
          const href = location.href;
          if (/\\/login|signin|auth|account\\/login/i.test(href)) return 'login';
          return href.includes('listenhub.ai/zh/app/home') &&
            document.readyState !== 'loading' &&
            document.body &&
            [...document.querySelectorAll('button, [role="button"]')].some(node =>
              (node.innerText || '').includes('签到'))
              ? 'true'
              : 'false';
        })()
      `
    );
    if (raw === "true") return;
    if (raw === "login") throw new Error("会话已过期，ListenHub 重定向到了登录页，请重新登录 Chrome");
    sleep(1);
  }
  throw new Error("ListenHub 首页加载超时（当前页面: " + runJs(tab, "location.href") + "）");
}

function readState(tab) {
  const raw = runJs(
    tab,
    `
      (() => {
        const visible = (node) => {
          if (!node) return false;
          const rect = node.getBoundingClientRect();
          const style = window.getComputedStyle(node);
          return rect.width > 0 &&
            rect.height > 0 &&
            style.display !== 'none' &&
            style.visibility !== 'hidden' &&
            Number(style.opacity || 1) > 0;
        };

        const bodyText = document.body ? document.body.innerText || '' : '';
        const compact = bodyText.replace(/\\s+/g, ' ');
        const checkinControl = [...document.querySelectorAll('button, [role="button"]')]
          .filter(visible).find(node => (node.innerText || '').includes('签到'));
        const checkinText = checkinControl ? checkinControl.innerText : '';

        const nodes = [...document.querySelectorAll('button, a, div, span, li, [role="button"]')].filter(visible);
        const candidates = nodes
          .map((node) => {
            const rect = node.getBoundingClientRect();
            const text = (node.innerText || node.textContent || '').replace(/\\s+/g, ' ').trim();
            return {
              text,
              left: Math.round(rect.left),
              top: Math.round(rect.top),
              width: Math.round(rect.width),
              height: Math.round(rect.height)
            };
          })
          .filter((item) => item.text.includes('签到') || item.text.includes('+15') || item.text.includes('领取'))
          .slice(0, 30);

        return JSON.stringify({
          href: location.href,
          hasAlready: checkinText.includes('已签到'),
          hasAvailableEntry: checkinText.includes('签到') && !checkinText.includes('已签到'),
          hasRewardModal: bodyText.includes('签到领取奖励') &&
            (bodyText.includes('+15') || bodyText.includes('通用积分')),
          bodyTextSample: compact.slice(0, 500),
          candidates
        });
      })()
    `
  );
  return JSON.parse(raw);
}

function clickSidebarCheckin(tab) {
  const raw = runJs(
    tab,
    `
      (() => {
        const visible = (node) => {
          if (!node) return false;
          const rect = node.getBoundingClientRect();
          const style = window.getComputedStyle(node);
          return rect.width > 0 &&
            rect.height > 0 &&
            style.display !== 'none' &&
            style.visibility !== 'hidden' &&
            Number(style.opacity || 1) > 0;
        };

        const fireClick = (node) => {
          const rect = node.getBoundingClientRect();
          const options = {
            bubbles: true,
            cancelable: true,
            composed: true,
            view: window,
            clientX: rect.left + rect.width / 2,
            clientY: rect.top + rect.height / 2
          };
          ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click'].forEach((type) => {
            node.dispatchEvent(new MouseEvent(type, options));
          });
          if (typeof node.click === 'function') {
            try { node.click(); } catch (e) {}
          }
        };

        const clickTarget = (node) =>
          node.closest('button, a, [role="button"]') ||
          node;

        const nodes = [...document.querySelectorAll('button, a, div, span, li, [role="button"]')]
          .filter(visible)
          .map((node) => {
            const rect = node.getBoundingClientRect();
            const text = (node.innerText || node.textContent || '').replace(/\\s+/g, ' ').trim();
            const leftScore = rect.left < Math.min(380, window.innerWidth * 0.35) ? 0 : 1000;
            const textScore =
              text.includes('签到') && text.includes('+15') ? 0 :
              text.includes('签到') && text.includes('领取') ? 20 :
              text.includes('签到') ? 80 :
              200;
            const area = rect.width * rect.height;
            return { node, text, rect, score: leftScore + textScore + area / 100000 + rect.top / 1000 };
          })
          .filter((item) =>
            item.text.includes('签到') &&
            !item.text.includes('签到领取奖励') &&
            item.rect.left < Math.min(380, window.innerWidth * 0.35) &&
            item.rect.width <= 360 &&
            item.rect.height <= 100 &&
            item.text.length <= 120 &&
            (item.text.includes('+15') || item.text.includes('领取') || item.text.includes('💎') || item.text.includes('🎁'))
          )
          .sort((a, b) => a.score - b.score);

        if (!nodes.length) {
          return JSON.stringify({ clicked: false, reason: '未找到左侧栏签到入口' });
        }

        const selected = nodes[0];
        fireClick(clickTarget(selected.node));
        return JSON.stringify({
          clicked: true,
          text: selected.text,
          left: Math.round(selected.rect.left),
          top: Math.round(selected.rect.top)
        });
      })()
    `
  );
  return JSON.parse(raw);
}

function waitForRewardModal(tab, timeoutSeconds) {
  const started = Date.now();
  while (Date.now() - started < timeoutSeconds * 1000) {
    const state = readState(tab);
    if (state.hasRewardModal) {
      return state;
    }
    if (state.hasAlready) {
      return state;
    }
    sleep(0.5);
  }
  return readState(tab);
}

function clickModalConfirm(tab) {
  const raw = runJs(
    tab,
    `
      (() => {
        const visible = (node) => {
          if (!node) return false;
          const rect = node.getBoundingClientRect();
          const style = window.getComputedStyle(node);
          return rect.width > 0 &&
            rect.height > 0 &&
            style.display !== 'none' &&
            style.visibility !== 'hidden' &&
            Number(style.opacity || 1) > 0;
        };

        const fireClick = (node) => {
          const rect = node.getBoundingClientRect();
          const options = {
            bubbles: true,
            cancelable: true,
            composed: true,
            view: window,
            clientX: rect.left + rect.width / 2,
            clientY: rect.top + rect.height / 2
          };
          ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click'].forEach((type) => {
            node.dispatchEvent(new MouseEvent(type, options));
          });
          if (typeof node.click === 'function') {
            try { node.click(); } catch (e) {}
          }
        };

        const modalCandidates = [...document.querySelectorAll('div, section, article, [role="dialog"]')]
          .filter(visible)
          .map((node) => {
            const rect = node.getBoundingClientRect();
            const text = (node.innerText || node.textContent || '').replace(/\\s+/g, ' ').trim();
            return { node, rect, text, area: rect.width * rect.height };
          })
          .filter((item) =>
            item.text.includes('签到领取奖励') &&
            (item.text.includes('+15') || item.text.includes('通用积分'))
          )
          .sort((a, b) => a.area - b.area);

        const modal = modalCandidates[0];
        if (!modal) {
          // 弹窗容器未找到时，尝试在页面中央查找文本为「签到」的可见按钮
          const fallbackBtns = [...document.querySelectorAll('button, [role="button"], div, span, a')]
            .filter(visible)
            .filter((n) => {
              const t = (n.innerText || n.textContent || '').replace(/\\s+/g, ' ').trim();
              const r = n.getBoundingClientRect();
              return t === '签到' &&
                r.left > window.innerWidth * 0.15 &&
                r.right < window.innerWidth * 0.85;
            });
          if (!fallbackBtns.length) {
            return JSON.stringify({ clicked: false, reason: '未识别到签到奖励弹窗' });
          }
          const fb = fallbackBtns[0];
          const fbRect = fb.getBoundingClientRect();
          fireClick(fb.closest('button, [role="button"]') || fb);
          return JSON.stringify({
            clicked: true,
            text: '签到',
            left: Math.round(fbRect.left),
            top: Math.round(fbRect.top),
            fallback: true
          });
        }

        const buttons = [...modal.node.querySelectorAll('button, [role="button"], div, span')]
          .filter(visible)
          .map((node) => {
            const rect = node.getBoundingClientRect();
            const text = (node.innerText || node.textContent || '').replace(/\\s+/g, ' ').trim();
            const style = window.getComputedStyle(node);
            return {
              node,
              rect,
              text,
              dark: style.backgroundColor === 'rgb(0, 0, 0)' || style.color === 'rgb(255, 255, 255)'
            };
          })
          .filter((item) => item.text === '签到' || item.text.endsWith('签到'))
          .sort((a, b) => {
            const darkScore = (b.dark ? 1 : 0) - (a.dark ? 1 : 0);
            if (darkScore !== 0) return darkScore;
            return b.rect.top - a.rect.top;
          });

        const selected = buttons[0];
        if (!selected) {
          return JSON.stringify({ clicked: false, reason: '弹窗出现但确认签到按钮未点击' });
        }

        const target = selected.node.closest('button, [role="button"]') || selected.node;
        fireClick(target);
        return JSON.stringify({
          clicked: true,
          text: selected.text,
          left: Math.round(selected.rect.left),
          top: Math.round(selected.rect.top)
        });
      })()
    `
  );
  return JSON.parse(raw);
}

function checkin() {
  const app = chrome();
  const win = ensureChromeWindow(app);

  // Always open a fresh background tab — never navigate or disturb existing pages
  const newTab = app.Tab();
  win.tabs.push(newTab);
  const tab = win.tabs.byId(win.tabs[win.tabs().length - 1].id());

  try {
    openUrl(tab, "https://listenhub.ai/zh/app/home");
    try {
      waitForPage(tab, 30);
    } catch (error) {
      if (!String(error.message).includes('首页加载超时')) throw error;
      openUrl(tab, "https://listenhub.ai/zh/app/home");
      waitForPage(tab, 30);
    }
    sleep(1);

    const before = readState(tab);
    before.points = readPoints();
    const logs = [];
    logs.push("打开 ListenHub 首页");
    logs.push("签到前积分: " + before.points);

    if (before.hasAlready && !before.hasAvailableEntry) {
      return {
        run_time: nowIso(),
        before_points: before.points,
        after_points: before.points,
        status: "already_checked_in",
        result: "success",
        detail: "页面已经显示已签到",
        steps: logs
      };
    }

    const sidebarClick = clickSidebarCheckin(tab);
    if (!sidebarClick.clicked) {
      const state = readState(tab);
      if (state.hasAlready) {
        logs.push("未点击左侧入口，但页面显示已签到");
        return {
          run_time: nowIso(),
          before_points: before.points,
          after_points: readPoints(),
          status: "already_checked_in",
          result: "success",
          detail: "页面已经显示已签到",
          steps: logs
        };
      }
      throw new Error(sidebarClick.reason + ": " + JSON.stringify(state));
    }

    logs.push("点击了左侧栏签到入口: " + sidebarClick.text);
    sleep(1);

    const modalState = waitForRewardModal(tab, 8);
    if (modalState.hasAlready && !modalState.hasRewardModal) {
      logs.push("点击左侧入口后页面显示已签到");
    } else if (!modalState.hasRewardModal) {
      throw new Error("未识别到签到奖励弹窗: " + JSON.stringify(modalState));
    } else {
      logs.push("识别到签到奖励弹窗");
      const modalClick = clickModalConfirm(tab);
      if (!modalClick.clicked) {
        throw new Error(modalClick.reason || "弹窗出现但确认签到按钮未点击");
      }
      logs.push("点击了弹窗里的签到按钮: " + modalClick.text);
    }

    let after = readState(tab);
    const deadline = Date.now() + 15000;
    while (Date.now() < deadline && !after.hasAlready) {
      sleep(1);
      after = readState(tab);
    }
    after.points = readPoints();
    logs.push("签到后积分: " + after.points);

    const pointsIncreased =
      typeof before.points === "number" &&
      typeof after.points === "number" &&
      after.points > before.points;
    const success = pointsIncreased && after.hasAlready;

    if (!success) {
      throw new Error("未核实签到到账：" + JSON.stringify({before_points: before.points, after_points: after.points, already_checked_in: after.hasAlready}));
    }

    return {
      run_time: nowIso(),
      before_points: before.points,
      after_points: after.points,
      status: "checked_in",
      result: "success",
      detail: "积分增加且页面显示已签到，已核实到账",
      balance_source: "official_api",
      sidebar_clicked: true,
      reward_modal_seen: modalState.hasRewardModal,
      modal_confirm_clicked: modalState.hasRewardModal,
      steps: logs
    };
  } finally {
    // Always close the tab we opened — success or failure
    try { tab.close(); } catch(e) {}
  }
}

try {
  const result = checkin();
  result.balance_source = "official_api";
  console.log(JSON.stringify(result, null, 2));
} catch (error) {
  console.log(JSON.stringify({
    run_time: nowIso(),
    status: "failed",
    result: "failed",
    message: String(error.message || error)
  }, null, 2));
  $.exit(1);
}
