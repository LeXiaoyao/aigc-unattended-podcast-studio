# ==============================================================================
# AIGC Unattended Podcast Studio — Environment Configuration Template
# Copy to `.env` or `shared/config/.env.listenhub` and fill in your own keys:
#   cp .env.example .env
# ==============================================================================

# --- 0. Podcast Metadata & Base URL (for Web UI & Standard RSS 2.0 Feed) ---
PODCAST_NAME="AI观测站"
PODCAST_DESCRIPTION="每日AI产业全链路观察，从芯片到应用，从趋势到判断"
PODCAST_AUTHOR="AI观测站"
PODCAST_LANGUAGE="zh-cn"
PODCAST_CATEGORY="Technology"
# Public base URL where `/rss.xml`, `/audio/{id}`, and `/cover/{id}` are served
PODCAST_BASE_URL="http://localhost:8765"

# --- 1. News Collection & Search APIs (Multi-Source Funnel) ---
# Tavily Search API (https://tavily.com) — Primary AI/Tech News Search
TAVILY_API_KEY="tvly-your-free-or-primary-api-key"
# Optional backup/paid Tavily key for automatic quota failover
TAVILY_API_KEY_PAID=""
# Brave Search API (https://brave.com/search/api/) — Secondary Search & Backfill
BRAVE_SEARCH_API_KEY=""
# Optional GitHub / Hugging Face / Apify tokens for higher rate limits
GITHUB_TOKEN=""
HUGGINGFACE_TOKEN=""
APIFY_TOKEN=""

# --- 2. LLM Providers (Research, Script Drafting, Polishing & QA Judge) ---
# DeepSeek API (OpenAI-compatible, primary script writer)
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Alibaba Cloud DashScope / Qwen API (Fallback LLM + Qwen-ASR timestamp alignment)
QWEN_API_KEY="sk-your-dashscope-qwen-api-key"
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-plus"

# Google Gemini API (Secondary script polish + cover image generation)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_SCRIPT_MODEL="gemini-2.5-flash"

# --- 3. TTS & Audio Synthesis ---
# 3A. Solo Daily Briefing (E1) — MiniMax Speech-02-HD TTS
MINIMAX_API_KEY="your-minimax-api-key"
MINIMAX_VOICE_ID="Chinese (Mandarin)_News_Anchor"
MINIMAX_TTS_MODEL="speech-02-hd"
MINIMAX_TTS_SPEED="1.03"

# 3B. Dual-Host Deep Dive (E2) — ListenHub API (Option 1: Recommended for Dual-Host)
LISTENHUB_API_KEY="lh_sk_your_listenhub_api_key"
LISTENHUB_SPEAKER_1="chat-girl-105-cn"
LISTENHUB_SPEAKER_2="CN-Man-Beijing-V2"
LISTENHUB_MODE="deep"

# 3C. Dual-Host / Solo Alternative — Volcengine (Doubao / 豆包语音) TTS (Option 2)
VOLC_TTS_APP_KEY=""
VOLC_TTS_ACCESS_TOKEN=""
VOLC_TTS_RESOURCE_ID="seed-tts-2.0"
VOLCENGINE_TTS_API_KEY=""

# --- 4. Publishing Channels & Mobile Control (Optional) ---
# Xiaoyuzhou Podcaster Studio 24-hex Podcast ID (from https://podcaster.xiaoyuzhoufm.com/podcast/<PID>/library)
XIAOYUZHOU_PODCAST_PID=""

# Web Admin Dashboard Password (http://localhost:8765/admin)
WEBAPP_ADMIN_PASSWORD="change-me-in-production"

# Feishu / Lark Bot Notification & Mobile Interactive Control (Optional)
FEISHU_WEBHOOK_URL=""
FEISHU_BOT_SECRET=""
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
FEISHU_EVENT_TOKEN=""
# Comma-separated Feishu open_ids allowed to trigger publish/TTS commands
FEISHU_ALLOWED_OPEN_IDS=""
